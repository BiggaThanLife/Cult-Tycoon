{
  "name": "cult-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/smoke.cjs",
    "sim": "tsx tools/sim/run.ts",
    "validate-levels": "tsx tools/levels/validate.ts",
    "check": "tsc --noEmit && vitest run && tsx tools/levels/validate.ts && tsx tools/sim/run.ts && vite build && node tests/e2e/smoke.cjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
